{
  "openapi": "3.0.3",
  "info": {
    "title": "Complex API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "description": "订单实体",
        "properties": {
          "id": {
            "type": "integer",
            "description": "订单 ID"
          },
          "orderNumber": {
            "type": "string",
            "description": "订单编号"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer",
            "description": "客户信息"
          },
          "items": {
            "type": "array",
            "description": "订单项列表",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "description": "订单状态"
          },
          "paymentMethod": {
            "$ref": "#/components/schemas/PaymentMethod",
            "description": "支付方式"
          },
          "totalAmount": {
            "type": "number",
            "format": "float",
            "description": "总金额"
          },
          "metadata": {
            "type": "object",
            "description": "附加元数据"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "标签列表"
          }
        },
        "required": ["id", "orderNumber", "customer", "status"]
      },
      "Customer": {
        "type": "object",
        "description": "客户实体",
        "properties": {
          "id": {
            "type": "integer"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "format": "phone"
          },
          "address": {
            "$ref": "#/components/schemas/Address",
            "description": "地址信息"
          },
          "preferences": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "notifications": {
                "type": "boolean"
              }
            }
          }
        },
        "required": ["id", "email"]
      },
      "Address": {
        "type": "object",
        "description": "地址实体",
        "properties": {
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "coordinates": {
            "$ref": "#/components/schemas/Coordinates"
          }
        },
        "required": ["street", "city", "country"]
      },
      "Coordinates": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "float"
          },
          "longitude": {
            "type": "number",
            "format": "float"
          }
        },
        "required": ["latitude", "longitude"]
      },
      "OrderItem": {
        "type": "object",
        "description": "订单项",
        "properties": {
          "productId": {
            "type": "integer"
          },
          "productName": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "format": "float"
          },
          "discount": {
            "type": "number",
            "format": "float",
            "default": 0
          },
          "subtotal": {
            "type": "number",
            "format": "float"
          }
        },
        "required": ["productId", "productName", "quantity", "unitPrice"]
      },
      "OrderStatus": {
        "type": "string",
        "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled", "refunded"],
        "description": "订单状态"
      },
      "PaymentMethod": {
        "type": "string",
        "enum": ["credit_card", "debit_card", "paypal", "bank_transfer", "cash_on_delivery"],
        "description": "支付方式"
      },
      "ProductVariant": {
        "type": "object",
        "description": "产品变体（包含保留字和特殊字符属性名）",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "class": {
            "type": "string",
            "description": "类别（TypeScript 保留字）"
          },
          "type": {
            "type": "string",
            "description": "类型（TypeScript 保留字）"
          },
          "product-code": {
            "type": "string",
            "description": "产品代码（包含连字符）"
          },
          "variant name": {
            "type": "string",
            "description": "变体名称（包含空格）"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attribute"
            }
          }
        },
        "required": ["id", "name"]
      },
      "Attribute": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "dataType": {
            "$ref": "#/components/schemas/DataType"
          }
        },
        "required": ["key", "value"]
      },
      "DataType": {
        "type": "integer",
        "enum": [-1, 0, 1, 2],
        "description": "数据类型（包含负数）"
      },
      "ApiResponse": {
        "type": "object",
        "description": "通用 API 响应",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "integer"
          },
          "data": {
            "type": "object"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["success"]
      },
      "PageInfo": {
        "type": "object",
        "description": "分页信息",
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "hasNext": {
            "type": "boolean"
          },
          "hasPrevious": {
            "type": "boolean"
          }
        },
        "required": ["total", "page", "pageSize"]
      }
    }
  }
}
